{
    "name": "wapplersystems/ws-scss",
    "type": "typo3-cms-extension",
    "description": "Compiles SCSS to CSS at runtime with caching, TypoScript variables and EXT: import support",
    "keywords": ["TYPO3", "scss", "sass", "css", "compiler", "scssphp"],
    "homepage": "https://github.com/WapplerSystems/ws_scss",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Sven Wappler",
            "email": "typo3@wappler.systems",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/WapplerSystems/ws_scss",
        "issues": "https://github.com/WapplerSystems/ws_scss/issues"
    },
    "require": {
        "php": "^8.2",
        "typo3/cms-core": "^14.0",
        "scssphp/scssphp": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "WapplerSystems\\WsScss\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "ws_scss"
        }
    }
}