{
    "name": "wapplersystems/ws-scss",
    "description": "SASS compiler for TYPO3",
    "type": "typo3-cms-extension",
    "homepage": "https://github.com/WapplerSystems/ws_scss",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "TYPO3",
        "extension",
        "scss",
        "sass"
    ],
    "authors": [
        {
            "name": "Sven Wappler",
            "email": "typo3@wappler.systems",
            "role": "Developer",
            "homepage": "https://wappler.systems"
        }
    ],
    "support": {
        "issues": "https://github.com/WapplerSystems/ws_scss/issues",
        "source": "https://github.com/WapplerSystems/ws_scss"
    },
    "require": {
        "typo3/cms-core": "^13",
        "php": "^8.0 || ^8.1 || ^8.2 || ^8.3",
        "scssphp/scssphp": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "WapplerSystems\\WsScss\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "ws_scss"
        }
    }
}